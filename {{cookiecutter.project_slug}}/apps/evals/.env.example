# Same variables as apps/backend/.env: the runner builds the same providers.
# ENVIRONMENT=local uses AZURE_OPENAI_API_KEY if set, otherwise Entra ID (az login).
ENVIRONMENT="local"
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.cognitiveservices.azure.com/"
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_API_KEY=""
OLLAMA_HOST="http://localhost:11434"
