# local | dev | uat | prod. Anything but local disables /docs and requires API_KEY.
ENVIRONMENT="local"
# Set by CI/deploy (e.g. the git tag).
APP_VERSION="0.0.1"

# Primary: Azure OpenAI / Foundry. Leave the endpoint empty to use only Ollama.
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_VERSION="2024-10-21"
# Only read when ENVIRONMENT=local. Other environments always use Entra ID (managed identity; `az login` locally).
AZURE_OPENAI_API_KEY=""

# Fallback.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen3-coder:30b"

# Logs, traces and requests go to Application Insights when set (cloud role = service, version and environment
# are attached to every record). Azure hosting can set this for you.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
LOG_LEVEL="INFO"
# Log question and raw LLM output (truncated to 2000 chars) for debugging. May contain personal data, so when unset
# it is on only for ENVIRONMENT=local|dev (off in uat/prod). Set true/false to override.
LOG_LLM_CONTENT=

# Retry per provider before falling back.
LLM_MAX_ATTEMPTS=3

# Required on /ask (X-API-Key header) unless ENVIRONMENT=local. /docs is only served when ENVIRONMENT=local.
API_KEY=""
# JSON list of exact frontend origins, e.g. ["https://app.example.com"]. Empty disables CORS.
CORS_ORIGINS="[]"
LLM_TIMEOUT_SECONDS=30
