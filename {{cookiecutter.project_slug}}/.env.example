# "local" uses the API keys below; anything else (or unset) uses Entra ID via DefaultAzureCredential.
ENVIRONMENT="local"
AZURE_OPENAI_ENDPOINT="https://YOUR_RESOURCE.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_API_KEY="ONLY_USED_WHEN_ENVIRONMENT_IS_LOCAL"
AZURE_OPENAI_API_VERSION="2024-10-21"
# Judge model for evals; falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_JUDGE_DEPLOYMENT=""
# Optional: send logs and traces to Application Insights.
APPLICATION_INSIGHTS_CONNECTION_STRING=""
{%- if cookiecutter.include_agent == "y" %}
# Agent (Microsoft Foundry project; Entra ID only).
FOUNDRY_PROJECT_ENDPOINT="https://YOUR_ACCOUNT.services.ai.azure.com/api/projects/YOUR_PROJECT"
FOUNDRY_MODEL_NAME="gpt-4o"
# Optional: ground the agent on an Azure AI Search index connected to the project.
AI_SEARCH_PROJECT_CONNECTION_ID=""
AI_SEARCH_INDEX_NAME=""
{%- endif %}
