# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node (apps/frontend)
node_modules/
dist/
build/

# Eval results (apps/evals/results/*.json are local experiment output)
apps/evals/results/*
!apps/evals/results/.gitkeep

# Terraform / Terragrunt (infra/). Keep .terraform.lock.hcl.
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
# Generated by Terragrunt from infra/root.hcl
backend.tf
provider.auto.tf
versions.auto.tf

# Environments and secrets
.env
.env.*
!.env.example

# IDEs and OS
.idea/
.vscode/
.DS_Store
